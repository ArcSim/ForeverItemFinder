# CurseForge / BigWigs packager metadata for Forever Item Finder.
# Everything under `ignore` is left OUT of the packaged addon zip.
package-as: ForeverItemFinder

# Use the formatted changelog for the CurseForge file notes instead of the packager's auto-generated commit list.
manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

ignore:
  - .git
  - .github
  - .gitignore
  - .gitattributes
  - .claude
  - .pkgmeta
  - CHANGELOG.md
  - README.md
  - CLAUDE.md
  - "*.bak"
  # the website, its old redirect page and the developer's own files
  - docs
  - site
  - DevMaps
  - Dev.lua
  - DevProbe.lua
  # retail test runs only
  - ForeverItemFinder_Mainline.toc
  - Data/RetailMaps.lua
